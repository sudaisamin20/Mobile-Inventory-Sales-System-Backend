<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice - <%= invoiceNo %></title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #fff;
      color: #111;
      font-size: 13px;
      padding: 16px;
    }

    /* ── Outer wrapper ── */
    .invoice {
      width: 100%;
      max-width: 780px;
      margin: 0 auto;
      border: 2px solid #c0392b;
    }

    /* ═══════════════════════════════════════
       HEADER
    ═══════════════════════════════════════ */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: stretch;
      border-bottom: 2px solid #c0392b;
    }

    /* LEFT: logo + shop name */
    .header-left {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      min-width: 280px;
    }

    .bmc-circle {
      width: 64px;
      height: 64px;
      border: 3px solid #c0392b;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .bmc-text {
      font-size: 18px;
      font-weight: 900;
      color: #c0392b;
      letter-spacing: 1px;
    }

    .shop-name-block {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .m-basit {
      font-size: 42px;
      font-weight: 900;
      color: #c0392b;
      line-height: 1;
      letter-spacing: 2px;
    }

    .mobile-center-badge {
      background: #c0392b;
      color: #fff;
      font-size: 16px;
      font-weight: 900;
      padding: 3px 12px;
      letter-spacing: 2px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .door-icon {
      display: inline-block;
      width: 12px;
      height: 18px;
      border: 2px solid #fff;
      border-radius: 1px;
      position: relative;
    }

    /* CENTER: tagline + branches */
    .header-center {
      flex: 1;
      padding: 10px 16px;
      color: #c0392b;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
    }

    .dealer-title {
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .import-export {
      font-size: 13px;
      font-weight: 700;
    }

    .branch-row {
      margin-top: 6px;
      font-size: 11px;
      font-weight: 600;
      display: flex;
      align-items: flex-start;
      gap: 4px;
    }

    .branch-box {
      width: 10px;
      height: 10px;
      border: 1.5px solid #c0392b;
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* RIGHT: contacts */
    .header-right {
      padding: 10px 14px;
      border-left: 1.5px solid #c0392b;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      min-width: 160px;
    }

    .contact-name {
      font-size: 12px;
      font-weight: 700;
      color: #c0392b;
      text-align: right;
    }

    .contact-number {
      background: #c0392b;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      text-align: center;
      border-radius: 2px;
    }

    .contact-sep {
      height: 1px;
      background: #c0392b;
      margin: 2px 0;
    }

    /* ═══════════════════════════════════════
       BILL NO / DATE ROW
    ═══════════════════════════════════════ */
    .bill-row {
      display: flex;
      border-bottom: 1.5px solid #c0392b;
      padding: 6px 16px;
      gap: 0;
    }

    .bill-no {
      flex: 1;
      font-size: 13px;
    }

    .bill-no strong, .bill-date strong {
      font-weight: 900;
      color: #c0392b;
    }

    .bill-date {
      flex: 1;
      font-size: 13px;
    }

    .underline-val {
      display: inline-block;
      border-bottom: 1px solid #555;
      min-width: 140px;
      padding: 0 4px;
    }

    /* ═══════════════════════════════════════
       CUSTOMER ROWS
    ═══════════════════════════════════════ */
    .customer-row {
      display: flex;
      border-bottom: 1.5px solid #c0392b;
      padding: 8px 16px;
    }

    .customer-field {
      flex: 1;
      font-size: 13px;
    }

    .customer-field strong {
      font-weight: 900;
      color: #c0392b;
    }

    .field-value {
      display: inline-block;
      border-bottom: 1px solid #555;
      min-width: 180px;
      padding: 0 4px;
    }

    /* ═══════════════════════════════════════
       DESCRIPTION TABLE HEADER
    ═══════════════════════════════════════ */
    .table-header {
      display: grid;
      grid-template-columns: 70px 1fr 180px 90px;
      background: #fff;
      border-bottom: 1.5px solid #c0392b;
    }

    .table-header-cell {
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 900;
      color: #c0392b;
      border-right: 1.5px solid #c0392b;
      text-align: center;
    }

    .table-header-cell:last-child {
      border-right: none;
    }

    /* ═══════════════════════════════════════
       MAIN CONTENT: DESCRIPTION + AMOUNTS + REMARKS
    ═══════════════════════════════════════ */
    .content-row {
      display: grid;
      grid-template-columns: 1fr 180px 90px;
      border-bottom: 1.5px solid #c0392b;
    }

    /* LEFT: description fields */
    .desc-section {
      border-right: 1.5px solid #c0392b;
      padding: 0;
    }

    .desc-row {
      display: flex;
      align-items: center;
      border-bottom: 1px solid #e8c8c8;
      padding: 8px 14px;
      gap: 8px;
      min-height: 38px;
    }

    .desc-row:last-child {
      border-bottom: none;
    }

    .desc-label {
      font-weight: 900;
      color: #c0392b;
      font-size: 13px;
      min-width: 70px;
    }

    .desc-line {
      flex: 1;
      border-bottom: 1px solid #888;
      padding: 0 6px;
      min-height: 18px;
      font-size: 13px;
      color: #111;
    }

    /* CENTER: amount section */
    .amount-section {
      border-right: 1.5px solid #c0392b;
      display: flex;
      flex-direction: column;
    }

    .amount-block {
      padding: 10px 12px;
      border-bottom: 1.5px solid #c0392b;
      flex: 1;
    }

    .amount-block:last-child {
      border-bottom: none;
    }

    .amount-label {
      font-weight: 900;
      color: #c0392b;
      font-size: 11px;
      letter-spacing: 0.5px;
      text-align: center;
      margin-bottom: 6px;
    }

    .amount-value {
      font-size: 16px;
      font-weight: 900;
      color: #111;
      text-align: center;
    }

    .amount-sub-row {
      margin-top: 6px;
    }

    .amount-sub-label {
      font-size: 10px;
      font-weight: 700;
      color: #c0392b;
    }

    .amount-sub-value {
      font-size: 13px;
      font-weight: 700;
      color: #111;
      margin-top: 2px;
    }

    /* payment checkboxes */
    .payment-row {
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 8px 6px;
    }

    .check-item {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 700;
      color: #333;
    }

    .cb {
      width: 13px;
      height: 13px;
      border: 1.5px solid #555;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 10px;
      color: #c0392b;
      font-weight: 900;
    }

    /* RIGHT: remarks section */
    .remarks-section {
      padding: 0;
    }

    .remarks-title {
      text-align: center;
      font-weight: 900;
      color: #c0392b;
      font-size: 12px;
      padding: 6px;
      border-bottom: 1px solid #e8c8c8;
      letter-spacing: 0.5px;
    }

    .remark-row {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 10px;
      border-bottom: 1px solid #e8c8c8;
      font-size: 12px;
      font-weight: 700;
      color: #333;
    }

    .remark-row:last-child {
      border-bottom: none;
    }

    /* ═══════════════════════════════════════
       SALE / PURCHASE ROW
    ═══════════════════════════════════════ */
    .type-row {
      display: flex;
      gap: 24px;
      padding: 8px 20px;
      border-bottom: 1.5px solid #c0392b;
      align-items: center;
    }

    .type-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 700;
      color: #333;
    }

    /* ═══════════════════════════════════════
       NOTES SECTION
    ═══════════════════════════════════════ */
    .notes-row {
      padding: 6px 16px;
      border-bottom: 1.5px solid #c0392b;
      font-size: 11.5px;
      color: #333;
      min-height: 32px;
    }

    .notes-row strong {
      color: #c0392b;
      font-weight: 900;
    }

    /* ═══════════════════════════════════════
       TERMS SECTION
    ═══════════════════════════════════════ */
    .terms-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-bottom: 1.5px solid #c0392b;
      font-size: 10.5px;
    }

    .terms-col {
      padding: 10px 14px;
    }

    .terms-col:first-child {
      border-right: 1.5px solid #c0392b;
    }

    .terms-col p {
      margin-bottom: 5px;
      line-height: 1.5;
      color: #333;
    }

    /* ═══════════════════════════════════════
       FOOTER: SIGNATURES
    ═══════════════════════════════════════ */
    .signature-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding: 20px 40px 16px;
      gap: 32px;
    }

    .sig-block {
      text-align: center;
    }

    .sig-line {
      border-top: 1.5px solid #333;
      margin-bottom: 6px;
    }

    .sig-label {
      font-size: 12px;
      font-weight: 700;
      color: #333;
    }

    /* ═══════════════════════════════════════
       RECEIPT ID FOOTER
    ═══════════════════════════════════════ */
    .receipt-id {
      text-align: center;
      font-size: 9px;
      color: #aaa;
      padding: 4px;
      border-top: 1px solid #eee;
      letter-spacing: 0.5px;
    }
  </style>
</head>

<body>
<div class="invoice">

  <!-- ══════════════════════════════════════
       HEADER
  ══════════════════════════════════════ -->
  <div class="header">

    <!-- Left: BMC Logo + Shop Name -->
    <div class="header-left">
      <div class="bmc-circle">
        <span class="bmc-text">BMC</span>
      </div>
      <div class="shop-name-block">
        <div class="m-basit">M.BASIT</div>
        <div class="mobile-center-badge">
          MOBILE CENTER
          <span style="display:inline-flex;gap:3px;margin-left:4px;">
            <span class="door-icon"></span>
            <span class="door-icon"></span>
          </span>
        </div>
      </div>
    </div>

    <!-- Center: Tagline + Branches -->
    <div class="header-center">
      <div class="dealer-title">WHOLE SALE DEALER</div>
      <div class="import-export">(Import &amp; Export)</div>

      <div class="branch-row">
        <span class="branch-box"></span>
        <div>
          <strong style="font-size:11px;">Branch 1:</strong><br/>
          Talasha Road, Haji Ajab Khan Kali
        </div>
      </div>
      <div class="branch-row">
        <span class="branch-box"></span>
        <div>
          <strong style="font-size:11px;">Branch 2:</strong><br/>
          Kamal Market, Adda Bazar Sherpao
        </div>
      </div>
    </div>

    <!-- Right: Contacts -->
    <div class="header-right">
      <div class="contact-name">M.Basit</div>
      <div class="contact-number">0333-8223831</div>
      <div class="contact-sep"></div>
      <div class="contact-name">Afzaal Syed</div>
      <div class="contact-number">0300-2669966</div>
      <div class="contact-sep"></div>
      <div class="contact-name">Qari Owais</div>
      <div class="contact-number">0309-2777218</div>
      <div class="contact-number">0313-9269166</div>
      <div class="contact-sep"></div>
      <div class="contact-name">M.Abbas</div>
      <div class="contact-number">0308-2777218</div>
    </div>

  </div>

  <!-- ══════════════════════════════════════
       BILL NO / DATE
  ══════════════════════════════════════ -->
  <div class="bill-row">
    <div class="bill-no">
      <strong>Bill No:</strong>
      <span class="underline-val"><%= invoiceNo %></span>
    </div>
    <div class="bill-date">
      <strong>Date:</strong>
      <span class="underline-val"><%= soldAt %></span>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       CUSTOMER NAME / MOBILE NO
  ══════════════════════════════════════ -->
  <div class="customer-row">
    <div class="customer-field">
      <strong>Customer Name:</strong>
      <span class="field-value"><%= customerName %></span>
    </div>
    <div class="customer-field">
      <strong>Mobile No:</strong>
      <span class="field-value"><%= phoneNo %></span>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       CNIC / ADDRESS (optional)
  ══════════════════════════════════════ -->
  <div class="customer-row">
    <div class="customer-field">
      <strong>CNIC No:</strong>
      <span class="field-value">&nbsp;</span>
    </div>
    <div class="customer-field">
      <strong>Address:</strong>
      <span class="field-value">&nbsp;</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       TABLE HEADER: S.No / Description / Total Amount / Remarks
  ══════════════════════════════════════ -->
  <div class="table-header">
    <div class="table-header-cell">S.No</div>
    <div class="table-header-cell" style="text-align:left;">Description</div>
    <div class="table-header-cell">Total Amount</div>
    <div class="table-header-cell">Remarks</div>
  </div>

  <!-- ══════════════════════════════════════
       MAIN CONTENT ROW
  ══════════════════════════════════════ -->
  <div class="content-row">

    <!-- LEFT: Description fields (with S.No 1 aligned) -->
    <div style="display:grid;grid-template-columns:70px 1fr;border-right:1.5px solid #c0392b;">

      <!-- S.No column -->
      <div style="border-right:1.5px solid #c0392b;display:flex;align-items:flex-start;justify-content:center;padding:10px 0;font-size:13px;font-weight:700;color:#333;">
        1
      </div>

      <!-- Device fields -->
      <div class="desc-section">
        <div class="desc-row">
          <span class="desc-label">Brand</span>
          <span class="desc-line"><%= brand %></span>
        </div>
        <div class="desc-row">
          <span class="desc-label">Model</span>
          <span class="desc-line"><%= model %></span>
        </div>
        <div class="desc-row">
          <span class="desc-label">IMEI 1</span>
          <span class="desc-line"><%= imei1 %></span>
        </div>
        <div class="desc-row">
          <span class="desc-label">IMEI 2</span>
          <span class="desc-line"><%= imei2 || '—' %></span>
        </div>
        <div class="desc-row">
          <span class="desc-label">Variant</span>
          <span class="desc-line"><%= variant || '—' %></span>
        </div>
        <div class="desc-row" style="border-bottom:none;">
          <span class="desc-label">Color</span>
          <span class="desc-line"><%= color || '—' %></span>
        </div>
      </div>
    </div>

    <!-- CENTER: Amounts + Payment -->
    <div class="amount-section">

      <!-- Total Amount block -->
      <div class="amount-block">
        <div class="amount-label">Total Amount</div>
        <div class="amount-value">PKR <%= Number(soldPrice).toLocaleString('en-PK') %></div>
      </div>

      <!-- Received + Remaining block -->
      <div class="amount-block">
        <div class="amount-sub-row">
          <div class="amount-sub-label">Received Amount</div>
          <div class="amount-sub-value">PKR <%= Number(receivedAmount).toLocaleString('en-PK') %></div>
        </div>
        <div class="amount-sub-row" style="margin-top:10px;">
          <div class="amount-sub-label">Remaining Amount</div>
          <div class="amount-sub-value" style="color:<%= remainingAmount > 0 ? '#c0392b' : '#27ae60' %>;">
            PKR <%= Number(remainingAmount).toLocaleString('en-PK') %>
          </div>
        </div>
      </div>

      <!-- Payment type checkboxes -->
      <div class="amount-block" style="border-bottom:none;padding:8px;">
        <div class="check-item" style="margin-bottom:6px;">
          <span class="cb"><%= paymentType === 'CASH' ? '✓' : '' %></span>
          Cash
        </div>
        <div class="check-item" style="margin-bottom:6px;">
          <span class="cb"><%= paymentType === 'EASYPAISA' ? '✓' : '' %></span>
          EasyPaisa
        </div>
        <div class="check-item" style="margin-bottom:6px;">
          <span class="cb"><%= paymentType === 'JAZZCASH' ? '✓' : '' %></span>
          JazzCash
        </div>
        <div class="check-item">
          <span class="cb"><%= (paymentType === 'BACKTRANSFER' || paymentType === 'BANK_TRANSFER') ? '✓' : '' %></span>
          Bank Transfer
        </div>
      </div>

    </div>

    <!-- RIGHT: Remarks -->
    <div class="remarks-section">
      <div class="remarks-title">Remarks</div>
      <div class="remark-row">
        <span class="cb"></span> New
      </div>
      <div class="remark-row">
        <span class="cb"></span> Old
      </div>
      <div class="remark-row">
        <span class="cb">✓</span> Sale
      </div>
      <div class="remark-row">
        <span class="cb"></span> Purchase
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════
       NOTES (if any)
  ══════════════════════════════════════ -->
  <% if (notes) { %>
  <div class="notes-row">
    <strong>Notes:</strong> <%= notes %>
  </div>
  <% } %>

  <!-- ══════════════════════════════════════
       TERMS & CONDITIONS
  ══════════════════════════════════════ -->
  <div class="terms-row">
    <div class="terms-col">
      <p>1. Mobile sold after complete customer satisfaction.</p>
      <p>2. Any dispute to be resolved within the shop premises.</p>
      <p>3. Company is not responsible for lost or stolen devices.</p>
      <p>4. PTA approved status verified at time of sale.</p>
    </div>
    <div class="terms-col" style="font-size:10.5px;line-height:1.6;color:#333;">
      <p>1. فروخت کے بعد موبائل واپس نہیں ہوگا۔</p>
      <p>2. کوئی بھی قسم کا کلیم بیچنے کے بعد قابل قبول نہیں۔</p>
      <p>3. 25% کٹوتی لازمی ہوگی اگر واپسی ضروری ہو۔</p>
      <p>4. دکاندار کی ذمہ داری صرف اسی وقت ہوگی جب موبائل دکان پر ہو۔</p>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       SIGNATURES
  ══════════════════════════════════════ -->
  <div class="signature-row">
    <div class="sig-block">
      <div class="sig-line"></div>
      <div class="sig-label">Customer Signature / دستخط فریدار</div>
    </div>
    <div class="sig-block">
      <div class="sig-line"></div>
      <div class="sig-label">Authorized Signature / دستخط فروخت کنندہ</div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       RECEIPT ID (for backend linkage)
  ══════════════════════════════════════ -->
  <div class="receipt-id">
    Receipt ID: <%= invoiceNo %> &nbsp;|&nbsp; Generated: <%= soldAt %>
  </div>

</div>
</body>
</html>
